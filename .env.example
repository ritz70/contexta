# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # holds the Supabase PUBLISHABLE key (sb_publishable_...) or a legacy anon key
SUPABASE_SERVICE_ROLE_KEY=       # holds the Supabase SECRET key (sb_secret_...) or a legacy service_role key
SUPABASE_DB_URL=                 # optional; Postgres connection string (Session pooler, IPv4-safe)

# LLM
LLM_PROVIDER=gemini              # gemini | openai | anthropic
LLM_API_KEY=
LLM_MODEL=                       # defaults to gemini-3.8-flash
LLM_BASE_URL=                    # only for openai-compatible providers

# Demo
DEMO_PASSWORD=Contexta#Demo2026
NEXT_PUBLIC_DEMO_MODE=true
